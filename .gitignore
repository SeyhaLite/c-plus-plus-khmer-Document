# Python
.venv/
__pycache__/
*.py[cod]

# Compiled gettext catalogues
*.mo

# Sphinx build output
docs/_build/
docs/.doctrees/

# Translation pipeline cache (downloaded source text is never committed:
# we store only URLs and metadata in data/, per source licensing rules)
data/.cache/

# Secrets and local configuration — never commit real credentials
.env
.env.*
!.env.example

# Logs and process files
*.log
*.pid

# Local macOS/editor noise
.DS_Store
.idea/
.vscode/
